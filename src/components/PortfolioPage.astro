---
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { PortfolioContent } from "@/types/portfolio";

interface Props {
  content: PortfolioContent;
}

const { content } = Astro.props;
const emailAddress = "anhtrinhtran3@gmail.com";
const email = `mailto:${emailAddress}`;
const github = "https://github.com/hkladoi";
const currentYear = new Date().getFullYear();
const labels = content.locale === "vi"
  ? {
      menu: "Điều hướng chính",
      location: "Địa điểm",
      status: "Trạng thái",
      email: "Email",
      github: "Mã nguồn",
      cv: "Hồ sơ",
      backToTop: "Lên đầu trang",
      openProject: "Mở dự án trong tab mới"
    }
  : {
      menu: "Primary navigation",
      location: "Location",
      status: "Status",
      email: "Email",
      github: "Code",
      cv: "Résumé",
      backToTop: "Back to top",
      openProject: "Open project in a new tab"
    };
---

<BaseLayout
  locale={content.locale}
  title={content.metadata.title}
  description={content.metadata.description}
  alternateHref={content.alternateHref}
>
  <header class="site-header">
    <div class="shell header-inner">
      <a class="wordmark" href="#top" aria-label="Trịnh Trần Đức Anh">Đức Anh<span>.</span></a>
      <nav aria-label={labels.menu}>
        <ul class="nav-list">
          {content.navigation.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
      </nav>
      <a class="language-link" href={content.alternateHref} hreflang={content.locale === "en" ? "vi" : "en"}>
        {content.alternateLanguageLabel}
      </a>
    </div>
  </header>

  <main id="main">
    <section class="intro shell" id="top" aria-labelledby="intro-title">
      <div class="intro-heading">
        <p class="section-label">{content.introduction.label}</p>
        <h1 id="intro-title">{content.introduction.name}<span>.</span></h1>
        <p class="role">{content.introduction.role}</p>
      </div>
      <div class="intro-copy">
        <p class="statement">{content.introduction.statement}</p>
        <p class="body-copy">{content.introduction.body}</p>
        <dl class="intro-meta">
          <div><dt>{labels.location}</dt><dd>{content.introduction.location}</dd></div>
          <div><dt>{labels.status}</dt><dd><span class="status-dot" aria-hidden="true"></span>{content.introduction.availability}</dd></div>
        </dl>
      </div>
    </section>

    <section class="contact-section" id="contact" aria-labelledby="contact-title">
      <div class="shell section-grid">
        <div>
          <p class="section-label">01 / {content.contact.label}</p>
          <h2 id="contact-title">{content.contact.title}</h2>
        </div>
        <div>
          <p class="section-intro">{content.contact.body}</p>
          <div class="contact-list">
            <a href={email}>
              <span>{labels.email}</span><strong>{emailAddress}</strong><i aria-hidden="true">↗</i>
            </a>
            <a href={github} target="_blank" rel="noreferrer">
              <span>{labels.github}</span><strong>{content.contact.githubLabel}</strong><i aria-hidden="true">↗</i>
            </a>
            <a href="/cv-trinh-tran-duc-anh.pdf" target="_blank" rel="noreferrer">
              <span>{labels.cv}</span><strong>{content.contact.cvLabel}</strong><i aria-hidden="true">↗</i>
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="section shell" id="experience" aria-labelledby="experience-title">
      <div class="section-grid section-heading">
        <p class="section-label">02 / {content.experience.label}</p>
        <h2 id="experience-title">{content.experience.title}</h2>
      </div>
      <div class="experience-list">
        {content.experience.items.map((item, index) => (
          <article class="experience-item">
            <span class="experience-index">0{index + 1}</span>
            <div class="experience-company">
              <h3>{item.company}</h3>
              <p>{item.role}</p>
            </div>
            <p class="experience-period">{item.period}</p>
            <div class="experience-detail">
              <p>{item.summary}</p>
              <ul aria-label="Technologies">
                {item.technologies.map((technology) => <li>{technology}</li>)}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="project-section" id="project" aria-labelledby="project-title">
      <div class="shell section-grid">
        <div>
          <p class="section-label">03 / {content.project.label}</p>
          <p class="project-type">{content.project.type}</p>
        </div>
        <a
          class="project-card"
          href={content.project.url}
          target="_blank"
          rel="noreferrer"
          aria-label={`${content.project.title} — ${labels.openProject}`}
        >
          <span class="project-domain">store.hkladoi.tech</span>
          <h2 id="project-title">{content.project.title}</h2>
          <p>{content.project.description}</p>
          <strong>{content.project.visitLabel}<i aria-hidden="true">↗</i></strong>
        </a>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="shell">
      <p>© {currentYear} Trịnh Trần Đức Anh</p>
      <p>{content.footer}</p>
      <a href="#top" aria-label={labels.backToTop}>↑</a>
    </div>
  </footer>
</BaseLayout>
