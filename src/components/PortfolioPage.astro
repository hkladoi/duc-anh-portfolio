---
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { PortfolioContent } from "@/types/portfolio";

interface Props {
  content: PortfolioContent;
}

const { content } = Astro.props;
const currentYear = new Date().getFullYear();
const labels = content.locale === "vi"
  ? {
      menu: "Điều hướng chính",
      location: "Địa điểm",
      status: "Trạng thái",
      email: "Email",
      github: "Mã nguồn",
      cv: "Hồ sơ",
      backToTop: "Lên đầu trang",
      openProject: "Mở dự án trong tab mới",
      projectOverview: "Dự án",
      responsibilities: "Công việc",
      addExperience: "+ Thêm kinh nghiệm",
      addProject: "+ Thêm dự án",
      drag: "Kéo để sắp xếp",
      moveUp: "Chuyển lên",
      moveDown: "Chuyển xuống",
      remove: "Xóa dòng"
    }
  : {
      menu: "Primary navigation",
      location: "Location",
      status: "Status",
      email: "Email",
      github: "Code",
      cv: "Résumé",
      backToTop: "Back to top",
      openProject: "Open project in a new tab",
      projectOverview: "Project",
      responsibilities: "Work",
      addExperience: "+ Add experience",
      addProject: "+ Add project",
      drag: "Drag to reorder",
      moveUp: "Move up",
      moveDown: "Move down",
      remove: "Delete row"
    };
---

<BaseLayout
  locale={content.locale}
  title={content.metadata.title}
  description={content.metadata.description}
  alternateHref={content.alternateHref}
>
  <header class="site-header">
    <div class="shell header-inner">
      <a class="wordmark" href="#top" aria-label="Trịnh Trần Đức Anh">Đức Anh<span>.</span></a>
      <nav aria-label={labels.menu}>
        <ul class="nav-list">
          {content.navigation.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
      </nav>
      <a class="language-link" href={content.alternateHref} hreflang={content.locale === "en" ? "vi" : "en"}>
        {content.alternateLanguageLabel}
      </a>
    </div>
  </header>

  <main id="main">
    <section class="intro shell" id="top" aria-labelledby="intro-title">
      <div class="intro-heading">
        <p class="section-label">{content.introduction.label}</p>
        <h1 id="intro-title"><span data-content-key="introduction.name" data-editable>{content.introduction.name}</span><span>.</span></h1>
        <p class="role" data-content-key="introduction.role" data-editable>{content.introduction.role}</p>
      </div>
      <div class="intro-copy">
        <p class="statement" data-content-key="introduction.statement" data-editable>{content.introduction.statement}</p>
        <p class="body-copy" data-content-key="introduction.body" data-editable>{content.introduction.body}</p>
        <dl class="intro-meta">
          <div><dt>{labels.location}</dt><dd data-content-key="introduction.location" data-editable>{content.introduction.location}</dd></div>
          <div><dt>{labels.status}</dt><dd><span class="status-dot" aria-hidden="true"></span><span data-content-key="introduction.availability" data-editable>{content.introduction.availability}</span></dd></div>
        </dl>
      </div>
    </section>

    <section class="contact-section" id="contact" aria-labelledby="contact-title">
      <div class="shell section-grid">
        <div>
          <p class="section-label">01 / {content.contact.label}</p>
          <h2 id="contact-title" data-content-key="contact.title" data-editable>{content.contact.title}</h2>
        </div>
        <div>
          <p class="section-intro" data-content-key="contact.body" data-editable>{content.contact.body}</p>
          <div class="contact-list">
            <a href={`mailto:${content.contact.email}`} data-content-href="contact.email" data-href-format="email" data-editor-link>
              <span>{labels.email}</span><strong data-content-key="contact.email" data-editable>{content.contact.email}</strong><i aria-hidden="true">↗</i>
            </a>
            <a href={content.contact.github} target="_blank" rel="noreferrer" data-content-href="contact.github" data-editor-link>
              <span>{labels.github}</span><strong data-content-key="contact.github" data-content-format="display-url" data-editable>{content.contact.github.replace(/^https?:\/\//, "")}</strong><i aria-hidden="true">↗</i>
            </a>
            <a href={`/api/cv?locale=${content.locale}`} target="_blank" rel="noreferrer" data-cv-link>
              <span>{labels.cv}</span><strong>{content.contact.cvLabel}</strong><i aria-hidden="true">↗</i>
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="section shell" id="experience" aria-labelledby="experience-title">
      <div class="section-grid section-heading">
        <p class="section-label">02 / {content.experience.label}</p>
        <div class="section-heading-action">
          <h2 id="experience-title">{content.experience.title}</h2>
          <button class="editor-add-row" type="button" data-editor-only data-add-row="experience">{labels.addExperience}</button>
        </div>
      </div>
      <div class="experience-list" data-row-container="experience">
        {content.experience.items.map((item, index) => (
          <article class="experience-item" data-editor-row="experience">
            <div class="editor-row-controls" data-editor-only>
              <button class="editor-drag-handle" type="button" draggable="true" title={labels.drag} aria-label={labels.drag}>⠿</button>
              <button type="button" data-move-row="up" title={labels.moveUp} aria-label={labels.moveUp}>↑</button>
              <button type="button" data-move-row="down" title={labels.moveDown} aria-label={labels.moveDown}>↓</button>
              <button type="button" data-remove-row title={labels.remove} aria-label={labels.remove}>×</button>
            </div>
            <span class="experience-index">{String(index + 1).padStart(2, "0")}</span>
            <div class="experience-company">
              <h3 data-content-key={`experience.items.${index}.company`} data-editable>{item.company}</h3>
              <p data-content-key={`experience.items.${index}.role`} data-editable>{item.role}</p>
            </div>
            <p class="experience-period" data-content-key={`experience.items.${index}.period`} data-editable>{item.period}</p>
            <div class="experience-detail">
              <div class="experience-description">
                <p>
                  <span>{labels.projectOverview}</span>
                  <span data-content-key={`experience.items.${index}.projectOverview`} data-editable>{item.projectOverview}</span>
                </p>
                <p>
                  <span>{labels.responsibilities}</span>
                  <span data-content-key={`experience.items.${index}.responsibilities`} data-editable>{item.responsibilities}</span>
                </p>
              </div>
              <ul aria-label="Technologies">
                {item.technologies.map((technology, technologyIndex) => (
                  <li data-content-key={`experience.items.${index}.technologies.${technologyIndex}`} data-editable>{technology}</li>
                ))}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="project-section" id="project" aria-labelledby="project-section-title">
      <div class="shell section-grid">
        <div class="project-section-heading">
          <p class="section-label" id="project-section-title">03 / {content.project.label}</p>
          <button class="editor-add-row" type="button" data-editor-only data-add-row="project">{labels.addProject}</button>
        </div>
        <div class="project-list" data-row-container="project">
          {content.project.items.map((item, index) => (
            <article class="project-item" data-editor-row="project">
              <div class="editor-row-controls" data-editor-only>
                <button class="editor-drag-handle" type="button" draggable="true" title={labels.drag} aria-label={labels.drag}>⠿</button>
                <button type="button" data-move-row="up" title={labels.moveUp} aria-label={labels.moveUp}>↑</button>
                <button type="button" data-move-row="down" title={labels.moveDown} aria-label={labels.moveDown}>↓</button>
                <button type="button" data-remove-row title={labels.remove} aria-label={labels.remove}>×</button>
              </div>
              <p class="project-type" data-content-key={`project.items.${index}.type`} data-editable>{item.type}</p>
              <a
                class="project-card"
                href={item.url}
                target="_blank"
                rel="noreferrer"
                aria-label={`${item.title} — ${labels.openProject}`}
                data-content-href={`project.items.${index}.url`}
                data-editor-link
              >
                <span class="project-domain" data-content-key={`project.items.${index}.url`} data-content-format="display-url" data-editable>{item.url.replace(/^https?:\/\//, "")}</span>
                <h2 data-content-key={`project.items.${index}.title`} data-editable>{item.title}</h2>
                <p data-content-key={`project.items.${index}.description`} data-editable>{item.description}</p>
                <strong>{content.project.visitLabel}<i aria-hidden="true">↗</i></strong>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="shell">
      <p>© {currentYear} Trịnh Trần Đức Anh</p>
      <p>{content.footer}</p>
      <a href="#top" aria-label={labels.backToTop}>↑</a>
    </div>
  </footer>
  <script is:inline type="module" src="/portfolio.js"></script>
</BaseLayout>
