---
import "@/styles/global.css";
import type { Locale } from "@/types/portfolio";

interface Props {
  locale: Locale;
  title: string;
  description: string;
  alternateHref: string;
}

const { locale, title, description, alternateHref } = Astro.props;
const canonicalPath = locale === "en" ? "/" : "/vi/";
const canonical = new URL(canonicalPath, Astro.site);
const alternate = new URL(alternateHref, Astro.site);
const english = new URL("/", Astro.site);
const vietnamese = new URL("/vi/", Astro.site);
const ogImage = new URL("/og-image.svg", Astro.site);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f1efe8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={english} />
    <link rel="alternate" hreflang="vi" href={vietnamese} />
    <link rel="alternate" hreflang="x-default" href={english} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={locale === "vi" ? "vi_VN" : "en_US"} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="alternate" href={alternate} />
    <title>{title}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      name: "Trịnh Trần Đức Anh",
      alternateName: "Trinh Tran Duc Anh",
      jobTitle: ".NET Developer",
      url: canonical.origin,
      email: "mailto:anhtrinhtran3@gmail.com",
      sameAs: ["https://github.com/hkladoi"],
      address: {
        "@type": "PostalAddress",
        addressLocality: "Hanoi",
        addressCountry: "VN"
      },
      knowsAbout: ["C#", ".NET", "ASP.NET", "Python", "FastAPI", "SQL", "RESTful API"]
    })} />
  </head>
  <body>
    <a class="skip-link" href="#main">{locale === "vi" ? "Bỏ qua đến nội dung" : "Skip to content"}</a>
    <slot />
  </body>
</html>
